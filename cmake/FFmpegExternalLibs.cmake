        set(HAVE_OPENSSL 0)
        message(STATUS "Found OpenSSL: NO")
    endif()
else()
    set(CONFIG_OPENSSL 0)
    set(HAVE_OPENSSL 0)
endif()

# GnuTLS (only if OpenSSL not found)
if(NOT CONFIG_OPENSSL)
    option(ENABLE_GNUTLS "Enable GnuTLS" ON)
    if(ENABLE_GNUTLS)
        pkg_check_modules(GNUTLS QUIET IMPORTED_TARGET gnutls)
        if(GNUTLS_FOUND)
            set(CONFIG_GNUTLS 1)
            set(HAVE_GNUTLS 1)
            set(USING_TLS_LIBRARY "gnutls")
            message(STATUS "Found GnuTLS: YES (${GNUTLS_VERSION})")
        else()
            set(CONFIG_GNUTLS 0)
            set(HAVE_GNUTLS 0)
            message(STATUS "Found GnuTLS: NO")
        endif()
    else()
        set(CONFIG_GNUTLS 0)
        set(HAVE_GNUTLS 0)
    endif()
else()
    # OpenSSL takes priority, disable GnuTLS
    set(CONFIG_GNUTLS 0)
    set(HAVE_GNUTLS 0)
endif()

