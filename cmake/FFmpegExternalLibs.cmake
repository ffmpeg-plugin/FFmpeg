# FFmpegExternalLibs.cmake
# Third-party library detection and configuration

include(CMakeFindDependencyMacro)
find_package(PkgConfig QUIET)

message(STATUS "Detecting external libraries...")

# ============================================================================
# Macro for external library detection
# ============================================================================
macro(ffmpeg_find_external_lib option_name pkg_name config_var)
    option(${option_name} "Enable ${pkg_name}" ON)
    if(${option_name})
        pkg_check_modules(${config_var} QUIET IMPORTED_TARGET ${pkg_name})
        if(${config_var}_FOUND)
            set(CONFIG_${config_var} 1)
            set(HAVE_${config_var} 1)
            message(STATUS "Found ${pkg_name}: YES (${${config_var}_VERSION})")
        else()
            set(CONFIG_${config_var} 0)
            set(HAVE_${config_var} 0)
            message(STATUS "Found ${pkg_name}: NO")
        endif()
    else()
        set(CONFIG_${config_var} 0)
        set(HAVE_${config_var} 0)
        message(STATUS "${pkg_name}: disabled by option")
    endif()
endmacro()

