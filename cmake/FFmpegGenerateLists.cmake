function(ffmpeg_scan_protocols SOURCE_DIR OUTPUT_FILE)
    # Scan all .c files for URLProtocol definitions
    file(GLOB SOURCES "${SOURCE_DIR}/*.c")
    set(PROTOCOL_LIST "")
    foreach(SRC ${SOURCES})
        file(READ ${SRC} CONTENT)
        # Match patterns like: const URLProtocol ff_xxx_protocol
        string(REGEX MATCHALL "const[ \t]+URLProtocol[ \t]+ff_([a-z0-9_]+)_protocol" MATCHES "${CONTENT}")
        foreach(MATCH ${MATCHES})
            string(REGEX REPLACE "const[ \t]+URLProtocol[ \t]+ff_([a-z0-9_]+)_protocol" "\\1" PROTO_NAME "${MATCH}")
            list(APPEND PROTOCOL_LIST "ff_${PROTO_NAME}_protocol")
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES PROTOCOL_LIST)
    list(SORT PROTOCOL_LIST)
    
    # Generate the list file with extern declarations
    set(LIST_CONTENT "/* Auto-generated by CMake - do not edit */\n")
    string(APPEND LIST_CONTENT "#include \"libavformat/url.h\"\n\n")
    # Add extern declarations
    foreach(PROTO ${PROTOCOL_LIST})
        string(APPEND LIST_CONTENT "extern const URLProtocol ${PROTO};\n")
    endforeach()
    string(APPEND LIST_CONTENT "\nstatic const URLProtocol * const url_protocols[] = {\n")
    foreach(PROTO ${PROTOCOL_LIST})
        string(APPEND LIST_CONTENT "    &${PROTO},\n")
    endforeach()
    string(APPEND LIST_CONTENT "    NULL\n};\n")
    file(WRITE ${OUTPUT_FILE} "${LIST_CONTENT}")
    message(STATUS "Generated protocol_list.c with ${PROTOCOL_LIST}")
endfunction()

# ============================================================================
# Convenience function to generate all libavformat lists
# ============================================================================

function(ffmpeg_generate_avformat_lists SOURCE_DIR OUTPUT_DIR)
    if(NOT EXISTS ${OUTPUT_DIR})
        file(MAKE_DIRECTORY ${OUTPUT_DIR})
    endif()
    
    ffmpeg_scan_muxers(${SOURCE_DIR} "${OUTPUT_DIR}/muxer_list.c")
    ffmpeg_scan_demuxers(${SOURCE_DIR} "${OUTPUT_DIR}/demuxer_list.c")
    ffmpeg_scan_protocols(${SOURCE_DIR} "${OUTPUT_DIR}/protocol_list.c")
endfunction()
