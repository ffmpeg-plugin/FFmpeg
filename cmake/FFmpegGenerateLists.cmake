# FFmpeg Component Lists Generator
# Scans source files to generate muxer_list.c, demuxer_list.c, protocol_list.c, etc.

message(STATUS "Generating component lists...")

# ============================================================================
# Scan functions
# ============================================================================

function(ffmpeg_scan_muxers SOURCE_DIR OUTPUT_FILE)
    # Scan all .c files for FFOutputFormat definitions
    file(GLOB SOURCES "${SOURCE_DIR}/*.c")
    set(MUXER_LIST "")
    foreach(SRC ${SOURCES})
        file(READ ${SRC} CONTENT)
        # Match patterns like: const FFOutputFormat ff_xxx_muxer
        string(REGEX MATCHALL "const[ \t]+FFOutputFormat[ \t]+ff_([a-z0-9_]+)_muxer" MATCHES "${CONTENT}")
        foreach(MATCH ${MATCHES})
            string(REGEX REPLACE "const[ \t]+FFOutputFormat[ \t]+ff_([a-z0-9_]+)_muxer" "\\1" MUXER_NAME "${MATCH}")
            # Exclude test muxers
            if(NOT MUXER_NAME MATCHES ".*_test$")
                list(APPEND MUXER_LIST "ff_${MUXER_NAME}_muxer")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES MUXER_LIST)
    list(SORT MUXER_LIST)
    
    # Generate the list file with extern declarations
    set(LIST_CONTENT "/* Auto-generated by CMake - do not edit */\n")
    string(APPEND LIST_CONTENT "#include \"libavformat/internal.h\"\n\n")
    # Add extern declarations
    foreach(MUXER ${MUXER_LIST})
        string(APPEND LIST_CONTENT "extern const FFOutputFormat ${MUXER};\n")
    endforeach()
    string(APPEND LIST_CONTENT "\nstatic const FFOutputFormat * const muxer_list[] = {\n")
    foreach(MUXER ${MUXER_LIST})
        string(APPEND LIST_CONTENT "    &${MUXER},\n")
    endforeach()
    string(APPEND LIST_CONTENT "    NULL\n};\n")
    file(WRITE ${OUTPUT_FILE} "${LIST_CONTENT}")
    message(STATUS "Generated muxer_list.c with ${MUXER_LIST}")
endfunction()

function(ffmpeg_scan_demuxers SOURCE_DIR OUTPUT_FILE)
